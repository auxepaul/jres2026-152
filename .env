# Variables pour le conteneur du stagiaire
#STAGIAIRE_DOCKER_IMAGE="renater/formation-centos9"
STAGIAIRE_DOCKER_IMAGE="auxepaules/centos9-jres2026"
STAGIAIRE_DOCKER_IMAGE_VERSION="chap06"

# Variables pour le conteneur SP
#SP_DOCKER_IMAGE="renater/formation-sp"
SP_DOCKER_IMAGE="auxepaules/sp-jres2026"
SP_DOCKER_IMAGE_VERSION="chap05"

# Variables pour le conteneur LDAP
LDAP_VERSION="2.6.13"
#LDAP_DOCKER_IMAGE="renater/formation-ldap"
LDAP_DOCKER_IMAGE="auxepaules/ldap-jres2026"
LDAP_DOCKER_IMAGE_VERSION="1.0"

# Variables pour le conteneur CAS
CAS_JAVA_VERSION="25"
CAS_BASE_IMAGE="azul/zulu-openjdk:25"
CAS_REPO="https://github.com/apereo/cas-overlay-template.git"
CAS_VERSION="8.0"
#CAS_DOCKER_IMAGE="renater/formation-cas"
CAS_DOCKER_IMAGE="auxepaules/cas-jres2026"
CAS_DOCKER_IMAGE_VERSION="1.0"
# Pour le MFA avec Esup-Otp et CAS
ESUPOTPCAS_DEPENDENCY="org.esup-portail:esup-otp-cas"
ESUPOTPCAS_VERSION="v2.3.1-cas_v8.0.x"

# Variables pour le conteneur IDP
IDP_JAVA_VERSION="21"
IDP_TOMCAT_VERSION_MAJOR="11"
IDP_TOMCAT_VERSION="11.0.29"
IDP_VERSION="5.2.3"
IDP_ENTITYID="https://idp-stagiaire.formation.lab/idp/shibboleth"
IDP_SECRET_PASSWORD="ChangeIt"
# Pour le MFA avec Esup-Otp et l'IdP Shibboleth
ESUPOTPSHIBBOLETH_REPO="https://github.com/Renater/esup-otp-shibboleth.git"
ESUPOTPSHIBBOLETH_REPO_VERSION="develop-1.2"
ESUPOTPSHIBBOLETH_VERSION="1.2.0"

# Variables pour le conteneur BROWSER
#BROWSER_DOCKER_IMAGE="renater/formation-browser"
BROWSER_DOCKER_IMAGE="auxepaules/browser-jres2026"
BROWSER_DOCKER_IMAGE_VERSION="1.0"

# Variables pour les conteneurs ESUP-OTP (DB, API et MANAGER)
MONGO_BASE_IMAGE="mongo:8.3"
MONGO_ROOT_PASSWORD="ChangeIt"
MONGO_USER_PASSWORD="ChangeIt"

ESUPOTPDB_DOCKER_IMAGE="auxepaules/esup-otp-db-jres2026"
ESUPOTPDB_DOCKER_IMAGE_VERSION="1.0"
NODEJS_VERSION="24"

ESUPOTPAPI_REPO="https://github.com/EsupPortail/esup-otp-api.git"
ESUPOTPAPI_VERSION="v2.4.0"
ESUPOTPAPI_DOCKER_IMAGE="auxepaules/esup-otp-api-jres2026"
ESUPOTPAPI_DOCKER_IMAGE_VERSION="1.0"

ESUPOTPMANAGER_REPO="https://github.com/EsupPortail/esup-otp-manager.git"
ESUPOTPMANAGER_VERSION="v2.0.3"
ESUPOTPMANAGER_DOCKER_IMAGE="auxepaules/esup-otp-manager-jres2026"
ESUPOTPMANAGER_DOCKER_IMAGE_VERSION="1.0"
